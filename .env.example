# ═══════════════════════════════════════════════════════════
# Daily Miracles MVP - Environment Variables
# ═══════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# 서버 설정 (Server Configuration)
# ─────────────────────────────────────────────────────────────
NODE_ENV=development          # development | staging | production
PORT=5100                     # Render는 자동 할당, 로컬은 5100 사용

# ─────────────────────────────────────────────────────────────
# 릴리즈 게이트 (Open Gate)
# ─────────────────────────────────────────────────────────────
APP_DISABLED=false            # true → 503 점검 모드
OUTBOUND_ENABLED=false        # true → 실발송 허용 (SMS/알림톡)
PLAZA_ENABLED=false           # true → /plaza 페이지 활성화

# ─────────────────────────────────────────────────────────────
# 앱 기본 URL (필수 - App Base URL)
# ─────────────────────────────────────────────────────────────
# 결제 콜백, 알림톡 링크 등에 사용되는 기본 도메인
APP_BASE_URL=https://app.dailymiracles.kr

# ─────────────────────────────────────────────────────────────
# CORS 설정 (필수 - CORS Configuration)
# ─────────────────────────────────────────────────────────────
# 쉼표로 구분하여 허용할 도메인 추가
# 프로덕션 권장값:
ALLOWED_ORIGINS=https://dailymiracles.kr,https://www.dailymiracles.kr,https://app.dailymiracles.kr

# ─────────────────────────────────────────────────────────────
# OpenAI API (필수 - Required)
# ─────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ─────────────────────────────────────────────────────────────
# DreamTown 이미지 생성 (Star Image System)
# scripts/generate-star-images.js 전용 설정
# ─────────────────────────────────────────────────────────────
DREAMTOWN_IMAGE_MODEL=gpt-image-1   # gpt-image-1 | dall-e-3
DREAMTOWN_IMAGE_SIZE=1024x1536      # 세로 portrait (gpt-image-1 지원: 1024x1024|1024x1536|1536x1024|auto)
DREAMTOWN_BATCH_SIZE=5              # 한 번에 처리할 장 수
DREAMTOWN_RETRY_COUNT=2             # 실패 시 최대 재시도 횟수
DREAMTOWN_MAX_COST=5.0              # USD 안전 한도 (초과 시 자동 중단)

# ─────────────────────────────────────────────────────────────
# 로깅 설정 (Logging)
# ─────────────────────────────────────────────────────────────
REQUEST_LOG=1                 # 1=활성화, 0=비활성화 (프로덕션은 0 권장)

# ─────────────────────────────────────────────────────────────
# 데이터베이스 (선택 - Optional Database)
# ─────────────────────────────────────────────────────────────
# PostgreSQL 사용 시에만 설정
# DATABASE_URL=postgresql://user:password@host:5432/database

# ─────────────────────────────────────────────────────────────
# SENS (네이버 클라우드 - 알림톡/SMS) ⭐ 현재 사용 중
# ─────────────────────────────────────────────────────────────
# https://console.ncloud.com/sens 에서 서비스 생성 후 설정
#
# [설정 순서]
# 1. NCP 콘솔 > IAM > 서브 계정 > API 키 발급
# 2. SENS > 알림톡 서비스 생성 > 서비스 ID 확인
# 3. SENS > SMS 서비스 생성 > 서비스 ID 확인 (failover용)
# 4. 카카오 채널 연동 (@dailymiracles)
# 5. 알림톡 템플릿 등록 및 승인

# 필수 설정
SENS_ACCESS_KEY=your-ncp-access-key          # NCP IAM 액세스 키
SENS_SECRET_KEY=your-ncp-secret-key          # NCP IAM 시크릿 키
SENS_SERVICE_ID=ncp:kkobizmsg:kr:xxxxx       # 알림톡 서비스 ID
SENS_SMS_SERVICE_ID=ncp:sms:kr:xxxxx         # SMS 서비스 ID (알림톡 실패 시 failover)
SENS_CHANNEL_ID=_xfxhcWn                     # 카카오 채널 ID (@dailymiracles)

# 알림톡 템플릿 코드 (카카오 승인 후 입력)
SENS_TEMPLATE_CODE=                          # 기적 결과 알림톡 템플릿
SENS_ACK_TEMPLATE_CODE=betawelcome           # 소원 접수 ACK 알림톡 템플릿 (웰컴)
SENS_QUOTE_TEMPLATE_CODE=                    # 견적 접수 알림톡 템플릿
SENS_MORNING_TEMPLATE_CODE=                  # 아침 응원 메시지 템플릿
SENS_EVENING_TEMPLATE_CODE=                  # 저녁 응원 메시지 템플릿
SENS_VOYAGE_NOTIFY_TEMPLATE_CODE=            # 항해 예약 확인 알림톡 (미설정 시 SMS fallback)

# 발신번호 설정
SENDER_PHONE=18996117                        # 알림톡/SMS 발신번호

# 기능 플래그
MSG_USE_SENS=true                            # SENS 사용 여부 (기본: true)

# ─────────────────────────────────────────────────────────────
# [레거시] Solapi (사용 안 함 - 참고용)
# ─────────────────────────────────────────────────────────────
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_PFID=

# ─────────────────────────────────────────────────────────────
# 긴급 알림 수신자
# ─────────────────────────────────────────────────────────────
CRO_PHONE=01012345678                        # 재미(CRO) - RED 신호 알림
EMERGENCY_ALERT_PHONE=01012345678            # 시스템 장애 알림

# ─────────────────────────────────────────────────────────────
# Airtable (관제탑 ACT)
# ─────────────────────────────────────────────────────────────
# https://airtable.com/create/tokens 에서 Personal Access Token 발급
AIRTABLE_API_KEY=pat.xxxxxxxxxxxx
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# 테이블명 (기본값 사용 시 생략 가능)
# AIRTABLE_TABLE_DAILY_HEALTH=Daily Health
# AIRTABLE_TABLE_ALERTS=Alerts

# ─────────────────────────────────────────────────────────────
# 알림 수신자 (Alert Recipients)
# ─────────────────────────────────────────────────────────────
COO_PHONE=01012345678                        # 코미(COO) - 모든 알림 수신
CEO_PHONE=01012345678                        # 푸르미르(CEO) - RED 알림만
QUALITY_PHONE=01012345678                    # 여의보주 - RED 알림만

# ─────────────────────────────────────────────────────────────
# 선택 사항 (Optional)
# ─────────────────────────────────────────────────────────────
# ORCHESTRATOR_ENABLED=false
# OPENAI_API_BASE=https://api.openai.com
# REQUEST_TIMEOUT=30000
# MAX_RETRIES=3

# ═══════════════════════════════════════════════════════════
# Ops Center (여수 운영 컨트롤타워)
# ═══════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# [필수 - 운영] 관리자 보안 토큰
# ─────────────────────────────────────────────────────────────
# 🔐 운영 환경에서는 반드시 설정 (32자 이상 랜덤 권장)
# /api/ops-center/rules/reload 보호용
ADMIN_TOKEN=CHANGE_ME_TO_RANDOM_SECRET_32CHARS

# ─────────────────────────────────────────────────────────────
# [개발/데모용] 폴백 토큰
# ─────────────────────────────────────────────────────────────
# ⚠️ 개발/데모 전용 - 운영에서는 ADMIN_TOKEN만 사용 권장
DEMO_RESET_TOKEN=demo-reset-token

# ─────────────────────────────────────────────────────────────
# [운영 안전] 룰 로딩 정책
# ─────────────────────────────────────────────────────────────
# true 권장 (운영) - rules preload 실패 시 서버 즉시 종료
# production 환경에서는 자동으로 true 적용
FAIL_FAST_RULES=true

# ─────────────────────────────────────────────────────────────
# [필수 - 프로덕션] Slack 운영 알림 Webhook
# ─────────────────────────────────────────────────────────────
# 미설정 시 프로덕션 배포 차단됨 (process.exit(1))
# Heartbeat, 운영 리포트, 비상 알림에 사용
# Slack App → Incoming Webhooks → #ops-alerts 채널
OPS_SLACK_WEBHOOK=https://hooks.slack.com/services/TXXXX/BXXXX/xxxxxxxx
# SLACK_WEBHOOK_URL은 OPS_SLACK_WEBHOOK의 별칭 (둘 중 하나만 설정해도 됨)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# ═══════════════════════════════════════════════════════════
# SkillsMP (14만 5천+ 스킬 마켓플레이스) - 기본 OFF
# ═══════════════════════════════════════════════════════════
# 토큰/비용 폭탄 위험으로 기본 비활성화
# 프로덕션(NODE_ENV=production)에서는 활성화 불가

# 명시적으로 true 설정 시에만 MCP 서버 실행
SKILLSMP_ENABLED=false

# https://skillsmp.com 에서 API 키 발급
# SKILLSMP_API_KEY=sk_live_skillsmp_your_key_here

# 검색 결과 최대 개수 (비용 제어)
SKILLSMP_MAX_RESULTS=10

# 컨텍스트 주입 토큰 상한 (긴 텍스트 주입 차단)
SKILLSMP_MAX_CONTEXT_TOKENS=1500

# ─────────────────────────────────────────────────────────────
# DreamTown 팬덤 엔진 튜닝
# ─────────────────────────────────────────────────────────────
# Blend Whisper 노출 확률 (0.0~1.0 / 기본 10%)
# 코드 수정 없이 서버 재시작으로 튜닝 가능
# 권장 실험 구간: 0.05 ~ 0.20
BLEND_RATIO=0.10


# ─────────────────────────────────────────────────────────────
# AI 비용 제어 (aiGateway.js)
# ─────────────────────────────────────────────────────────────
# 무료 유저 1인당 AI 호출 최대 횟수 (기본 5)
AI_MAX_CALLS_PER_USER=5
# 일일 전체 AI 예산 (원, 기본 30,000)
AI_DAILY_BUDGET_KRW=30000
# AI 결과 캐시 TTL (분, 기본 10080 = 7일)
AI_CACHE_TTL_MINUTES=10080
# fallback 응답 사용 여부 (기본 true)
AI_FALLBACK_ENABLED=true

# ═══════════════════════════════════════════════════════════
# C3A RAMADA Storybook Customer Photo Upload
# ═══════════════════════════════════════════════════════════
# Configuration for POST /api/storybook/:journey_id/upload endpoint
# Validates MIME types, file sizes, and location/slot combinations

# Maximum file size in bytes (5MB default)
STORYBOOK_MAX_FILE_SIZE=5242880

# Allowed MIME types (comma-separated)
STORYBOOK_ALLOWED_MIMES=image/jpeg,image/png,image/webp

# Canonical locations for Golden 9-Cut (comma-separated)
STORYBOOK_REAL_LOCATION_WHITELIST=jinamgwan,cablecar,jongpo

# Canonical slots for C3A customer upload (only real_a, real_b)
STORYBOOK_REAL_SLOT_WHITELIST=real_a,real_b

# Frontend URL for restore links and redirects
FRONTEND_URL=http://localhost:5100

# ═══════════════════════════════════════════════════════════
# Storybook Storage Configuration (C6 Production Bridge)
# ═══════════════════════════════════════════════════════════
# Adapter: local (dev/test) | supabase (staging) | s3 (production)
# Default: local (safe for development)
# C7A Staging: supabase (Supabase Storage, same security as S3)
# Production: s3 (AWS S3, ephemeral filesystem not allowed)

# Storage Type: local | supabase | s3
STORAGE_TYPE=local

# ─────────────────────────────────────────────────────────────
# Supabase Storage (C7A Staging)
# ─────────────────────────────────────────────────────────────
# Backend-only: Service Role Key (Never in .env.example or git)
# Project URL (from Supabase dashboard → Settings → API)
# SUPABASE_URL=https://[project-id].supabase.co
#
# Service Role Secret (from Supabase dashboard → Settings → API → Service role secret)
# ⚠️ NEVER expose to client code, logs, git, or .env.example
# ⚠️ Must exist ONLY in Render environment secrets (or backend env)
# ⚠️ RLS policies NOT NEEDED (service role bypasses them)
# SUPABASE_SERVICE_ROLE_KEY=[from-supabase-service-role-secret]
#
# Storage bucket (must be created in Supabase Storage as Private)
# SUPABASE_STORAGE_BUCKET=storybook-assets

# ─────────────────────────────────────────────────────────────
# AWS S3 Configuration (Production)
# ─────────────────────────────────────────────────────────────
# AWS_REGION: AWS region (default: us-east-1)
# AWS_S3_BUCKET: S3 bucket name (e.g., storybook-assets-prod)
# AWS_ACCESS_KEY_ID: IAM access key (use IAM roles, never in .env)
# AWS_SECRET_ACCESS_KEY: IAM secret key (use IAM roles, never in .env)
#
# Security Requirements:
#    - Credentials via IAM roles (Render/EC2), not .env
#    - Bucket: PRIVATE (no public URLs, no enumeration)
#    - Signed URLs only (15-min expiry minimum)
#    - EXIF removal enforced before upload
#
AWS_REGION=us-east-1
# AWS_S3_BUCKET=storybook-assets-prod

# Signed URL TTL (in seconds, default 900 = 15 minutes)
SIGNED_URL_TTL_SECONDS=900

# Optional: Allow local filesystem storage in production (default: false)
# ⚠️ WARNING: Never enable in actual production without explicit approval
# ALLOW_LOCAL_STORAGE=false

# ═══════════════════════════════════════════════════════════
# Guardian Dispatch V0 (소원별 상태확인 자동 SMS 발송)
# ═══════════════════════════════════════════════════════════
# 매일 21:00 KST에 신규 소원에 대해 "상태확인" 메시지 자동 발송
#
# 동의 기반: want_message=true (7일 추적 메시지 수신 동의)
# → 일반 마케팅 동의가 아닌 추적 메시지 수신 명시 동의 필수
#
# 대상 기준: wish_entry (같은 사용자도 여러 wish에 대해 각각 발송)
# 중복 방지: wish_entry_id + dispatch_date 단위
#
# 6가지 필터:
#   1. 신규 소원 (배포 이후 생성)
#   2. 추적 메시지 동의 (want_message=true)
#   3. 개인정보 동의
#   4. 유효한 이름 (2-20자, 정상명)
#   5. 유효한 전화 (010 국내 휴대폰)
#   6. wish_entry 단위 중복 발송 방지

# ─────────────────────────────────────────────────────────────
# [필수] Guardian Dispatch 활성화 플래그
# ─────────────────────────────────────────────────────────────
# false (기본) → 스케줄러 등록하지 않음 (안전)
# true → 스케줄러 활성화 (server.js 부팅 시 등록)
#
# ⚠️ 배포 준비 체크리스트:
#    [ ] migration 실행 (097_guardian_dispatch_setup.sql)
#    [ ] GUARDIAN_DISPATCH_ENABLED=true
#    [ ] GUARDIAN_DISPATCH_DRY_RUN=true (Phase 1)
#    [ ] GUARDIAN_DISPATCH_CUTOFF_AT=<배포시각> (자동 또는 수동 기록)
#    [ ] 첫 21:00 KST 실행 후 Dry Run 결과 확인
#    [ ] 1주일 모니터링 후 Phase 2 승인 (별도 지시)
GUARDIAN_DISPATCH_ENABLED=false

# ─────────────────────────────────────────────────────────────
# [필수] Phase 제어 (Dry Run vs Live)
# ─────────────────────────────────────────────────────────────
# Phase 1 (Dry Run): true
#   → 로깅만 (message_dispatch_logs에 status='dry_run' 기록)
#   → SMS 실제 발송 금지
#   → 기본 모드 (안전)
#
# Phase 2 (Live): false
#   → 실제 SMS 발송 시작
#   → 수동 승인 후 환경변수 변경 필수
#
# 💡 변경 절차:
# 1. Phase 1에서 1주일 드라이런 모니터링
# 2. 결과 검증: 전체 / 통과 / 제외사유별 집계 확인
# 3. 사람이 명시적으로 승인
# 4. 환경변수 변경: GUARDIAN_DISPATCH_DRY_RUN=false
# 5. 서버 재배포
#
# ⚠️ 절대 금지:
#    - 자동 전환 (1주일 후 자동으로 Live 전환 X)
#    - Backfill (과거 데이터 일괄 발송 X)
#    - 환경변수 재배포 없이 변경 (반드시 배포와 함께)
GUARDIAN_DISPATCH_DRY_RUN=true

# ─────────────────────────────────────────────────────────────
# [필수] 배포 기준 타임스탐프 (절대 변경 금지)
# ─────────────────────────────────────────────────────────────
# Guardian Dispatch V0가 Production에 최초 배포된 UTC 시각
# 이 시점 이전의 모든 wish_entry는 테스트 데이터로 간주하여
# 영구적으로 Guardian Dispatch 대상에서 제외됨
#
# 형식: ISO 8601 (YYYY-MM-DDTHH:MM:SSZ)
# 예: 2026-08-16T14:30:45Z
#
# 설정 방식 (택 1):
# A. 자동 (권장): 미설정 상태로 배포하면 첫 가동 시 현재 시각 자동 기록
# B. 수동: Production 배포 완료 직후 정확한 UTC 시각 수동 기록
#
# ⚠️ 중요:
#    - 배포 완료 직후 또는 첫 가동 시 자동으로 결정됨
#    - 이후 절대 변경 금지
#    - 타임존 혼동 주의: 반드시 UTC 기준 (KST - 9시간)
#    - 변경 시 cutoff 이후 사용자만 대상이 되므로 신중히 결정
#
# 기본값 (미설정): 배포 시점에 자동 설정됨
GUARDIAN_DISPATCH_CUTOFF_AT=
