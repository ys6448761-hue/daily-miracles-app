# ═══════════════════════════════════════════════════════════
# Staging Environment Configuration (C7A Testing)
# ═══════════════════════════════════════════════════════════
# Use: NODE_ENV=staging node server.js
# Or:  Render deploy with these environment variables
#
# This configuration enables:
# - Private S3 storage (no public URLs)
# - Staging database (separate from production)
# - Signed URLs with 15-min expiry
# - EXIF removal pipeline
# - Full synthetic journey lifecycle testing
# ═══════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────
NODE_ENV=staging
PORT=5000

# ─────────────────────────────────────────────────────────────
# Database (Staging Supabase)
# ─────────────────────────────────────────────────────────────
# Set to your staging Supabase connection string
# Format: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=postgresql://staging_user:staging_password@staging.db.supabase.co:5432/daily_miracles_staging?sslmode=require

# ─────────────────────────────────────────────────────────────
# Storage Configuration (C7A: Supabase Storage)
# ─────────────────────────────────────────────────────────────
# Type: local (dev/test) | supabase (staging) | s3 (production)
STORAGE_TYPE=supabase

# Supabase Storage Configuration (dreamtown-storybook-staging)
# Project URL (from Supabase dashboard → Settings → API)
SUPABASE_URL=https://[staging-project-id].supabase.co

# Service Role Key (Backend-Only, Full Permissions)
# ⚠️ NEVER expose to client code, logs, git, or .env.example
# ⚠️ Must exist ONLY in Render environment secrets
# ⚠️ From: Supabase dashboard → Settings → API → Service role secret
# ⚠️ Backend-only: RLS policies NOT NEEDED (service role bypasses them)
SUPABASE_SERVICE_ROLE_KEY=[from-supabase-service-role-secret]

# Storage bucket name (must be created in Supabase Storage as Private)
SUPABASE_STORAGE_BUCKET=storybook-assets

# Signed URL TTL (15 minutes standard, backend-generated server-side)
SIGNED_URL_TTL_SECONDS=900

# ─────────────────────────────────────────────────────────────
# Frontend Configuration
# ─────────────────────────────────────────────────────────────
APP_BASE_URL=https://storybook-staging.dailymiracles.kr
FRONTEND_URL=https://storybook-staging.dailymiracles.kr
ALLOWED_ORIGINS=https://storybook-staging.dailymiracles.kr

# ─────────────────────────────────────────────────────────────
# OpenAI API (if needed for testing)
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-staging-openai-key-here

# ─────────────────────────────────────────────────────────────
# Logging & Debugging
# ─────────────────────────────────────────────────────────────
REQUEST_LOG=1  # Enable request logging for debugging
DEBUG_STORAGE=1  # Enable storage adapter logging

# ─────────────────────────────────────────────────────────────
# Release Gates (Staging Testing)
# ─────────────────────────────────────────────────────────────
APP_DISABLED=false  # App is active
OUTBOUND_ENABLED=false  # No real SMS/notification sending
PLAZA_ENABLED=false  # Don't expose plaza features

# ─────────────────────────────────────────────────────────────
# Storybook Configuration
# ─────────────────────────────────────────────────────────────
STORYBOOK_MAX_FILE_SIZE=5242880  # 5MB
STORYBOOK_ALLOWED_MIMES=image/jpeg,image/png,image/webp
STORYBOOK_REAL_LOCATION_WHITELIST=jinamgwan,cablecar,jongpo
STORYBOOK_REAL_SLOT_WHITELIST=real_a,real_b
STORYBOOK_STORY_ART_WHITELIST=story_art

# ═══════════════════════════════════════════════════════════
# C7A Testing Notes
# ═══════════════════════════════════════════════════════════
#
# Synthetic Journey Lifecycle (C7A test):
# 1. POST /api/storybook/start
#    → Creates journey, session, restore token
#
# 2. REAL photo uploads (6 total)
#    → POST /api/storybook/:id/upload (jinamgwan/real_a, real_b, ...)
#    → EXIF removed, S3 stored, DB tracked
#    → Status: photos_in_progress → photos_complete
#
# 3. Story Art uploads (3 total)
#    → POST /api/admin/storybook/:id/upload-story-art
#    → Operator API (x-admin-key)
#    → Status: art_in_progress → storybook_complete
#
# 4. Golden 9 Rendering
#    → GET /api/storybook/my-journey
#    → 9 signed URLs (15-min expiry)
#    → Frontend: GoldenNineCut component
#
# 5. Star Planting
#    → POST /api/storybook/:id/plant-star
#    → Creates star (skip_artifact=true)
#    → Status: storybook_complete → star_planted
#
# 6. Restore Test
#    → GET /api/storybook/restore?token=...
#    → New session, same journey
#
# 7. Golden 9 Retrieval
#    → GET /api/storybook/my-journey
#    → Verify star_planted, assets still signed
#
# All steps logged for C7A evidence report.
#
# ═══════════════════════════════════════════════════════════
